{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Versioned typed AST for structural update program composition in Moonshot",
  "max_composition_depth": 3,
  "operators": [
    {
      "args": {
        "max_norm": "float [0.1, 10.0]"
      },
      "name": "ClipGradNorm"
    },
    {
      "args": {
        "factor": "float [0.0, 1.0]",
        "group": "int [0, 5]"
      },
      "name": "AttenuateGroup"
    },
    {
      "args": {
        "group": "int [0, 5]"
      },
      "name": "ProtectGroup"
    },
    {
      "args": {
        "ratio": "float [0.0, 0.5]"
      },
      "name": "ReplayAnchorBatch"
    },
    {
      "args": {
        "inner_steps": "int [20, 90]"
      },
      "name": "WarmupCosineSchedule"
    },
    {
      "args": {
        "weight_decay": "float [0.0001, 0.1]"
      },
      "name": "MomentumDecouple"
    },
    {
      "args": {},
      "name": "IdentityNoOp"
    }
  ],
  "title": "UpdateRuleDSL",
  "version": "1.0"
}